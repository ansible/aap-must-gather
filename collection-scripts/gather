#!/bin/bash

# Parse arguments
RENDER_WEBPAGE=false
for arg in "$@"; do
  case "$arg" in
    --render-webpage) RENDER_WEBPAGE=true ;;
  esac
done

# Set BASE_COLLECTION_PATH if not already set by must-gather framework
