convert_all_files_to_html() {
  echo "Converting files to HTML for browser viewing..."

  if [ -d "${BASE_COLLECTION_PATH}/logs" ]; then
    find "${BASE_COLLECTION_PATH}/logs" -type f -name "*.log" 2>/dev/null | while read logfile; do
      convert_to_html "$logfile"
    done
  fi

  if [ -d "${BASE_COLLECTION_PATH}/commands" ]; then
    find "${BASE_COLLECTION_PATH}/commands" -type f -name "*.log" 2>/dev/null | while read logfile; do
      convert_to_html "$logfile"
    done
  fi

  if [ -d "${BASE_COLLECTION_PATH}/pod-status" ]; then
    find "${BASE_COLLECTION_PATH}/pod-status" -type f -name "*.log" 2>/dev/null | while read logfile; do
      convert_to_html "$logfile"
    done
  fi

  if [ -d "${BASE_COLLECTION_PATH}/resources" ]; then
    find "${BASE_COLLECTION_PATH}/resources" -type f -name "*.log" 2>/dev/null | while read logfile; do
      convert_to_html "$logfile"
    done
  fi

  if [ -d "${BASE_COLLECTION_PATH}/cluster" ]; then
    find "${BASE_COLLECTION_PATH}/cluster" -type f -name "*.log" 2>/dev/null | while read logfile; do
      convert_to_html "$logfile"
    done
  fi

  if [ -f "${BASE_COLLECTION_PATH}/gather-aap.log" ]; then
    convert_to_html "${BASE_COLLECTION_PATH}/gather-aap.log"
  fi

  if [ -d "${BASE_COLLECTION_PATH}/configs" ]; then
    find "${BASE_COLLECTION_PATH}/configs" -type f \( -name "*.conf" -o -name "*.yml" -o -name "*.py" \) 2>/dev/null | while read configfile; do
      convert_to_html "$configfile"
    done
  fi

  if [ -d "${BASE_COLLECTION_PATH}/summary" ]; then
    find "${BASE_COLLECTION_PATH}/summary" -type f -name "*.txt" 2>/dev/null | while read txtfile; do
      convert_to_html "$txtfile"
    done
  fi

  if [ -d "${BASE_COLLECTION_PATH}/crds" ]; then
    find "${BASE_COLLECTION_PATH}/crds" -type f -name "*.txt" 2>/dev/null | while read txtfile; do
      convert_to_html "$txtfile"
    done
  fi

  if [ -d "${BASE_COLLECTION_PATH}/operators" ]; then
    find "${BASE_COLLECTION_PATH}/operators" -type f -name "*.yaml" 2>/dev/null | while read yamlfile; do
      convert_to_html "$yamlfile"
    done
  fi

  if [ -d "${BASE_COLLECTION_PATH}/cluster" ]; then
    find "${BASE_COLLECTION_PATH}/cluster" -type f -name "*.yaml" 2>/dev/null | while read yamlfile; do
      convert_to_html "$yamlfile"
    done
  fi

  echo "HTML conversion completed."
}

